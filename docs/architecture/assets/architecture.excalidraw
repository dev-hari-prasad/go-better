    },
    {
      "id": "C7Z-5oyKp8wwaeUEQ6L7S",
      "type": "text",
      "x": 14833.578439734589,
      "y": 3021.715853856367,
      "width": 1664.20703125,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 1172851771,
      "version": 59,
      "versionNonce": 1609780219,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786448784359,
      "link": null,
      "locked": false,
      "text": "Important:\n> One consumer, two messages, two reviews posted. Fix is cheap: store the X-GitHub-Delivery header ID (with short TTL) \nand drop it if already seen\n> make sure the transition rules live in one shared place (enum/lib) that every worker imports, not copy-pasted per handler \n— otherwise the \"who can update what\" invariant drifts silently as workers get added.\n> DLQ needs retry limits/backoff. Otherwise a permanently broken job can loop forever.\n> Redis durability matters. If those queues represent work you absolutely cannot lose, configure the Redis mechanism accordingly—\nor eventually consider a more durable broker depending on scale/reliability requirements.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Important:\n> One consumer, two messages, two reviews posted. Fix is cheap: store the X-GitHub-Delivery header ID (with short TTL) \nand drop it if already seen\n> make sure the transition rules live in one shared place (enum/lib) that every worker imports, not copy-pasted per handler \n— otherwise the \"who can update what\" invariant drifts silently as workers get added.\n> DLQ needs retry limits/backoff. Otherwise a permanently broken job can loop forever.\n> Redis durability matters. If those queues represent work you absolutely cannot lose, configure the Redis mechanism accordingly—\nor eventually consider a more durable broker depending on scale/reliability requirements.",
      "autoResize": true,
      "lineHeight": 1.25
    },
