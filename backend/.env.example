# ==========================================
# GoBetter Backend Environment Configuration
# ==========================================

# Server Network Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gobetter_db

# Redis Connection (BullMQ queues, user sessions, BYOK caching)
REDIS_URL=redis://localhost:6379

# AI Provider Configuration (Platform Fallback)
BASE_MODEL=openai/gpt-4o
AI_API_KEY=your_openai_or_openrouter_api_key
AI_BASE_URL=https://api.openai.com/v1
OPEN_AI_INTERFACE=chat

# Symmetric Encryption Key for BYOK Storage (AES-256)
API_ENCRYPTION_KEY=generate_a_random_32_byte_secret_hex

# Email Service (Resend API for verification OTPs and password resets)
RESEND_API_KEY=re_your_resend_api_key

# Platform Branding & Transactional Email Settings
BRAND_NAME="Go Better"
BRAND_URL="https://gobetter.dev"
BRAND_TAGLINE="Autonomous AI Code Reviews"
FROM_EMAIL="noreply@mail.gobetter.dev"
FROM_SENDER="Go Better <noreply@mail.gobetter.dev>"
EMAIL_THEME="dark"
COPYRIGHT_YEAR="2026"
BRAND_LOGO_URL="https://gobetter.dev/gobetter-logo.png"
